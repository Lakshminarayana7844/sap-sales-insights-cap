{
  "_version": "1.58.0",
  "sap.app": {
    "id": "sales.insights",
    "type": "application",
    "title": "Sales Insights",
    "applicationVersion": { "version": "1.0.0" },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/sales/",
        "type": "OData",
        "settings": { "odataVersion": "4.0" }
      }
    }
  },
  "sap.ui": { "deviceTypes": { "desktop": true, "tablet": true, "phone": true } },
  "sap.ui5": {
    "rootView": { "viewName": "sales.insights.view.Main", "type": "XML", "async": true, "id": "main" },
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": { "sap.m": {}, "sap.ui.core": {}, "sap.viz": {}, "sap.f": {} }
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": { "operationMode": "Server", "autoExpandSelect": true, "earlyRequests": true }
      },
      "i18n": { "type": "sap.ui.model.resource.ResourceModel", "settings": { "bundleName": "sales.insights.i18n.i18n" } }
    }
  }
}
